# build / packaging
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# venvs
.venv/
venv/

# test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# artefacts must never live in this repository (ADR-0001 D9).
# Transcripts, frames and audit reports belong in the vault.
frames/
*.webm
*.mp4
*.opus
*.wav

# run outputs. `Bundle.open` falls back to `./output/<lecture>` when
# $XDG_STATE_HOME is unset, so a run started in this working tree drops 29
# artefacts and 58 PNGs into the repository with nothing ignoring them. A test
# run with `--output-dir` puts the same flat set under any name given.
output/
*.log

# a bundle written into the tree carries its frames in `images/`, not `frames/`
images/

# the zipapp the README's single-file build writes with `-o dyak`
/dyak

# graphify: the knowledge map is committed (STATUS.md points to it); the
# AST/semantic cache inside it is regenerable and stays out
graphify-out/cache/
