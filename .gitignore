# build / packaging
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# venvs
.venv/
venv/

# test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# artefacts must never live in this repository (ADR-0001 D9).
# Transcripts, frames and audit reports belong in the vault.
frames/
*.webm
*.mp4
*.opus
*.wav

# run outputs. The default bundle root is `$XDG_STATE_HOME/dyak/<lecture>`, else
# `~/.local/state/dyak/<lecture>` (`bundle.state_root`, `Bundle.open`) -- outside
# this repository, so a run started in this working tree drops nothing here. This
# rule is defensive: it catches a run explicitly pointed into the tree with
# `--output-dir output/...` or `DYAK_OUTPUT_DIR=output/...`.
output/
*.log

# a bundle written into the tree carries its frames in `images/`, not `frames/`
images/

# the zipapp the README's single-file build writes with `-o dyak`
/dyak

# graphify: the knowledge map is committed (STATUS.md points to it); the
# AST/semantic cache inside it is regenerable and stays out
graphify-out/cache/
